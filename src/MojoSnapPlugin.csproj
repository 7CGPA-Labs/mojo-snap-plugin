<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>MojoSnapPlugin</AssemblyName>
    <RootNamespace>MojoSnapPlugin</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Authors>7CGPA-Labs</Authors>
    <Company>7CGPA-Labs</Company>
    <Copyright>Copyright © 7CGPA-Labs 2026</Copyright>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.8.10" PrivateAssets="All" />
    <PackageReference Include="Jellyfin.Model" Version="10.8.10" PrivateAssets="All" />
    <PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
    <PackageReference Include="Fleck" Version="1.2.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="logo96.png" />
    <EmbeddedResource Include="Web\configPage.html" />
  </ItemGroup>

  <!-- Embed Java ME launcher pages into the plugin assembly -->
  <ItemGroup>
    <EmbeddedResource Include="Web\j2me.html">
      <LogicalName>MojoSnapPlugin.Web.j2me.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Web\j2me.js">
      <LogicalName>MojoSnapPlugin.Web.j2me.js</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
